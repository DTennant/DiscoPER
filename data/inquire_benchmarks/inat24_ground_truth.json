        "class",
        "latitude",
        "month"
      ],
      "pattern_type": "correlation",
      "citation": "Neate-Clegg et al. (2024) Nat. Ecol. Evol."
    },
    {
      "id": "amphibian_spring_emergence",
      "tier": "novel",
      "difficulty": "moderate",
      "description": "Amphibian observations show a sharp spring peak (March-May) driven by breeding season emergence",
      "variables": [
        "class",
        "month"
      ],
      "pattern_type": "group_difference",
      "citation": "Herpetological phenology literature"
    },
    {
      "id": "lepidoptera_latitude_range",
      "tier": "novel",
      "difficulty": "moderate",
      "description": "Lepidoptera (butterflies/moths) show a wider latitudinal range than other insect orders",
      "variables": [
        "order",
        "abs_latitude"
      ],
      "pattern_type": "group_difference",
      "citation": "Butterfly distribution ecology"
    },
    {
      "id": "fungi_temperate_concentration",
      "tier": "novel",
      "difficulty": "moderate",
      "description": "Fungi observations are more concentrated in temperate zones (40-60N) compared to animals and plants",
      "variables": [
        "kingdom",
        "abs_latitude"
      ],
      "pattern_type": "group_difference",
      "citation": "Int. J. Biometeorol. 67:1509-1522 (2023)"
    },
    {
      "id": "mammal_crepuscular_pattern",
      "tier": "novel",
      "difficulty": "moderate",
      "description": "Mammal observations are more evenly distributed across months than bird observations, reflecting lower seasonal activity variation",
      "variables": [
        "class",
        "month"
      ],
      "pattern_type": "group_difference",
      "citation": "Mammalian activity pattern literature"
    },
    {
      "id": "hemisphere_season_inversion",
      "tier": "novel",
      "difficulty": "complex",
      "description": "Seasonal observation patterns invert between Northern and Southern hemispheres across all kingdoms",
      "variables": [
        "hemisphere",
        "month",
        "kingdom"
      ],
      "pattern_type": "three_way_interaction",
      "citation": "Int. J. Biometeorol. 67:1509-1522 (2023)"
    },
    {
      "id": "latitude_species_richness_gradient",
      "tier": "novel",
      "difficulty": "complex",
      "description": "Species richness per unit area increases toward the equator, following the latitudinal diversity gradient",
