{
  "dataset": "inat24_50k",
  "description": "Ground truth patterns for 50K-sample iNaturalist 2024 dataset",
  "n_observations": 50000,
  "n_species": 9776,
  "patterns": [
    {
      "id": "prior_observer_bias",
      "tier": "prior",
      "difficulty": "simple",
      "description": "Observations are concentrated in North America and Europe due to iNaturalist user demographics",
      "variables": [
        "latitude",
        "longitude"
      ],
      "pattern_type": "group_difference"
    },
    {
      "id": "prior_taxonomic_diversity",
      "tier": "prior",
      "difficulty": "simple",
      "description": "Dataset spans 3 kingdoms (Animalia, Plantae, Fungi) with Animalia being the largest",
      "variables": [
        "kingdom"
      ],
      "pattern_type": "group_difference"
    },
    {
      "id": "obvious_seasonal_peak",
      "tier": "obvious",
      "difficulty": "simple",
      "description": "Observations peak in May-September in the Northern Hemisphere (citizen science activity bias)",
      "variables": [
        "month",
        "hemisphere"
      ],
      "pattern_type": "correlation"
    },
    {
      "id": "fungi_autumn_peak",
      "tier": "novel",
      "difficulty": "simple",
      "description": "Fungi observations are concentrated in September-November, reflecting fruiting body seasonality",
      "variables": [
        "kingdom",
        "month"
      ],
      "pattern_type": "group_difference",
      "citation": "Woodland Trust Nature Calendar; Farmatsiia (2020)"
    },
    {
      "id": "plant_spring_bias",
      "tier": "novel",
      "difficulty": "simple",
      "description": "Plant observations peak earlier in the year (Apr-Jun) than animal observations (May-Aug)",
      "variables": [
        "kingdom",
        "month"
      ],
      "pattern_type": "group_difference",
      "citation": "Phenological ecology literature"
    },
    {
      "id": "insecta_tropical_concentration",
      "tier": "novel",
      "difficulty": "simple",
      "description": "Insect observations are more concentrated in tropical latitudes (<30 degrees) compared to mammals",
      "variables": [
        "class",
        "abs_latitude"
      ],
      "pattern_type": "group_difference",
      "citation": "Global insect distribution literature"
    },
    {
      "id": "bird_latitude_season_migration",
      "tier": "novel",
      "difficulty": "moderate",
      "description": "Bird observations shift northward from spring to summer in the Northern Hemisphere, reflecting migration",
