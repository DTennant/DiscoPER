    },
    {
      "id": "elevation_proxy_via_latitude",
      "tier": "novel",
      "difficulty": "complex",
      "description": "Plant families associated with alpine/montane habitats show higher-latitude observations in mid-latitudes",
      "variables": [
        "family",
        "abs_latitude",
        "kingdom"
      ],
      "pattern_type": "conditional_confound",
      "citation": "Alpine ecology literature"
